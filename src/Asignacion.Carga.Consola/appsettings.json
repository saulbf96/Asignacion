{
  "_Ambiente": "Local = base de esta maquina; Pruebas = 175.10.1.159 / WFM. Se puede cambiar con --ambiente.",
  "Ambiente": "Local",

  "BaseDatos": {
    "CadenaConexion": "",
    "Procedimiento": "ASIG.SP_CARGA",
    "TiempoEsperaSegundos": 300
  },

  "Correo": {
    "Habilitado": true,
    "Servidor": "smtp.gmail.com",
    "Puerto": 587,
    "Seguridad": "StartTls",
    "Usuario": "saulbf675@gmail.com",
    "Remitente": "saulbf675@gmail.com",
    "NombreRemitente": "Carga Asignacion",
    "VariableContrasena": "ASIGNACION_SMTP_PASSWORD",
    "TiempoEsperaSegundos": 30,
    "DestinatariosRespaldo": [ "wfm_ti@1csb.com.mx", "desarrollouno@1csb.com.mx" ]
  },

  "Unificacion": {
    "VariableContrasena": "ASIGNACION_ZIP_PASSWORD",
    "CarpetaTemporal": "",
    "Reglas": {
      "LEGAL": {
        "Comentario": "Mismo proceso que el Power Query DETALLE_CARTERA_V2 de WFM (consultas CARTERA TEL_SCL, CARTERA TEL_SMART y CARTERA TEL).",
        "Grupos": [
          { "Nombre": "SCL", "Patrones": [ "scl", "LT*_Segmento*" ] },
          { "Nombre": "SMART", "Patrones": [ "smart", "Cartera_Seg*" ], "Renombrar": { "PREVENTA": "TIPO_CARTERA", "GESTORES": "TIPO_GESTION" } }
        ],
        "ColumnasExcluidas": [ "TIPO_QUEJA" ],
        "Reemplazos": [
          { "Columnas": [ "TELEFONO1", "TELEFONO2", "TELEFONO3", "TELEFONO4" ], "Valor": "N/A", "Por": "0" }
        ],
        "Tipos": [
          {
            "Tipo": "Texto",
            "Columnas": [ "CLIENTE_UNICO", "NOMBRE_CTE", "GENERO_CLIENTE", "OCUPACION", "DIRECCION_CTE", "COLONIA_CTE", "POBLACION_CTE", "ESTADO_CTE",
                          "TERRITORIO", "TERRITORIAL", "ZONA", "ZONAL", "NOMBRE_DESPACHO", "GERENCIA", "REFERENCIAS_DOMICILIO", "CLASIFICACION_CTE",
                          "DIQUE", "PRODUCTO", "ESTRATEGIA", "CALLE_EMPLEO", "COLONIA_EMPLEO", "POBLACION_EMPLEO", "ESTADO_EMPLEO", "NOMBRE_AVAL",
                          "CALLE_AVAL", "COLONIA_AVAL", "POBLACION_AVAL", "ESTADO_AVAL", "FIDIAPAGO", "TIPOTEL1", "TIPOTEL2", "TIPOTEL3", "TIPOTEL4",
                          "GESTION_DESC", "CAMPANIA_RELAMPAGO", "CAMPANIA", "PREVENTA", "GRUPO_MAZ", "GESTORES", "ESTATUS_PLAN", "EMPLEADO", "CANAL",
                          "ESTATUS_PROMESA_PAGO" ]
          },
          {
            "Tipo": "Entero",
            "Columnas": [ "EDAD_CLIENTE", "NUM_EXT_CTE", "NUM_INT_CTE", "CP_CTE", "DIAS_ASIGNACION", "ATRASO_MAXIMO", "DIAS_ATRASO", "PAGO_NORMAL",
                          "IMP_ULTIMO_PAGO", "NUM_EXT_EMPLEO", "NUM_INT_EMPLEO", "TEL_AVAL", "NUM_EXT_AVAL", "CP_AVAL", "TELEFONO1", "TELEFONO2",
                          "TELEFONO3", "TELEFONO4", "DESPACHO_GESTIONO", "ID_GRUPO", "CLAVE_SPEI", "PAGOS_CLIENTE", "FOLIO_PLAN", "SEGMENTO_GENERACION",
                          "SEMANAS_ATRASO", "ATRASO", "ABONO_SEMANAL", "PLAZO", "MONTO_ABONADO", "MONTO_PLAN", "ENGANCHE", "PAGOS_RECIBIDOS",
                          "SALDO_ANTES_DEL_PLAN", "SALDO_ATRASADO_ANTES_PLAN", "MORATORIOS_ANTES_PLAN", "MONTO_PROMESA_PAGO" ]
          },
          {
            "Tipo": "Decimal",
            "Columnas": [ "SALDO", "MORATORIOS", "SALDO_TOTAL", "SALDO ATRASADO", "SALDO REQUERIDO", "LATITUD", "LONGITUD", "MONTO_PAGOS" ]
          },
          {
            "Tipo": "Fecha",
            "Columnas": [ "FECHA_ASIGNACION", "FECHA_ULTIMO_PAGO", "ULTIMA_GESTION", "GENERACION_PLAN", "CANCELACION_CUMPLIMIENTO_PLAN", "ULTIMO_ESTATUS" ]
          }
        ],
        "FilasExcluidas": [
          { "Columna": "CAMPANIA", "EmpiezaCon": [ "QUEJA", "CLON" ] }
        ],
        "ColumnasNuevas": [
          { "Nombre": "NUEVA/REASIGNADA", "DespuesDe": "CLIENTE_UNICO", "Resaltar": true },
          { "Nombre": "TIPO_ASIG", "DespuesDe": "CLIENTE_UNICO", "Resaltar": true },
          { "Nombre": "SUB TIPO", "DespuesDe": "CLIENTE_UNICO", "Resaltar": true },
          { "Nombre": "ESTATUS_TEL", "DespuesDe": "CLIENTE_UNICO", "Resaltar": true },
          { "Nombre": "NOMBRE_DESPACHO_", "DespuesDe": "NOMBRE_DESPACHO", "Valor": "58721-INTEGRATED SOLUTIONS BUREAU" },
          { "Nombre": "TIPO_GESTION_", "DespuesDe": "GESTORES", "CopiaDe": "GESTORES" }
        ],
        "ColumnasDuplicado": [ "CLIENTE_UNICO" ]
      }
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "File",
        "Args": {
          "path": "logs/carga-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
